{
  "headers": [
    {
      "source": "/((?!assets(?:/|$)|api(?:/|$)).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets(?:/|$)|api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
